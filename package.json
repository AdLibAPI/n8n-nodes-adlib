{
	"name": "n8n-nodes-adlib",
	"version": "0.1.0",
	"description": "n8n community node for the AdLib API: search the public ad libraries of Meta, Google, TikTok, LinkedIn, Pinterest and X, resolve advertisers from a domain, check if a company is advertising, and get webhook alerts when competitors start, stop or change ads.",
	"license": "MIT",
	"homepage": "https://github.com/adlib/n8n-nodes-adlib",
	"keywords": [
		"n8n-community-node-package",
		"ad library",
		"meta ad library",
		"google ads transparency",
		"tiktok ads",
		"linkedin ads",
		"competitor ads",
		"ad monitoring",
		"adlib",
		"n8n"
	],
	"author": {
		"name": "AdLib",
		"email": "support@example.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adlib/n8n-nodes-adlib.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AdLibApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AdLib/AdLib.node.js",
			"dist/nodes/AdLibTrigger/AdLibTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.52.3",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "21.1.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
